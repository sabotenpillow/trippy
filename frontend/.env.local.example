# Environment Variables

# Google Maps API Key (required for map features and route search)
# Get your API key from: https://console.cloud.google.com/google/maps-apis/
# Required APIs: Maps JavaScript API, Places API, Directions API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here

# Google AdSense Client ID (optional, for displaying ads)
# Get your client ID from: https://www.google.com/adsense/
# Format: ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_CLIENT_ID=your_adsense_client_id_here
