# Environment Variables

# Google Maps API Key (required for map features and route search)
# Get your API key from: https://console.cloud.google.com/google/maps-apis/
# Required APIs: Maps JavaScript API, Places API, Directions API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here

# Google AdSense Client ID (optional, for displaying ads)
# Get your client ID from: https://www.google.com/adsense/
# Format: ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_CLIENT_ID=your_adsense_client_id_here

# NextAuth Configuration (required for authentication)
# Generate a random secret: openssl rand -base64 32
AUTH_SECRET=your_nextauth_secret_here

# Google OAuth Credentials (required for Google sign-in)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID with authorized redirect URI:
# http://localhost:3000/api/auth/callback/google (development)
# https://your-domain.com/api/auth/callback/google (production)
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here
